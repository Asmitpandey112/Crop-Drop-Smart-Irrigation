# ==========================================
# CROP DROP - PRODUCTION ENVIRONMENT VARIABLES
# ==========================================
# Rename this file to .env before deploying

# --- Backend Settings ---
# For Docker Compose, this is usually: postgresql://<user>:<password>@db:5432/<dbname>
DATABASE_URL=postgresql://cropdrop_user:cropdrop_password@db:5432/cropdrop_db

# --- Frontend Settings ---
# The public URL where your React app will try to access the backend API.
# If deploying to a server (e.g., AWS, Render), change this to your actual domain.
VITE_API_URL=https://api.yourdomain.com/api

# --- Database Settings (if spinning up Postgres via Docker) ---
POSTGRES_USER=cropdrop_user
POSTGRES_PASSWORD=cropdrop_password
POSTGRES_DB=cropdrop_db
